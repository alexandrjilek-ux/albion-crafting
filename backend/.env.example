# Comma-separated allowed CORS origins.
# Use "*" for dev (default). In production set explicit Expo / web origins.
# Example:
#   ALBION_CORS_ORIGINS=https://albion-forge.app,https://staging.albion-forge.app
ALBION_CORS_ORIGINS=*

# AODP region — currently hardcoded in core/albion_crafting.py to europe.
# Reserved for future runtime override.
# ALBION_AODP_REGION=europe
