# Public env vars are bundled into the web/client app. Do NOT put secrets here.
#
# Copy this to .env.local before a production web export, or set the same
# variable in EAS Environment Variables for the selected deployment environment.

# Public FastAPI backend URL used by guild testers.
EXPO_PUBLIC_API_URL=https://api.your-domain.tld

# App Store Connect non-consumable product id for lifetime unlock.
EXPO_PUBLIC_IAP_LIFETIME_PRODUCT_ID=lifetime_full_access
