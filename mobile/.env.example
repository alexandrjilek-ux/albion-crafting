# Public env vars are exposed to the client bundle. Do NOT put secrets here.
# Override per environment by copying to .env.local (git-ignored).

# Backend FastAPI base URL.
#   - iOS simulator: http://localhost:8000
#   - Android emulator: http://10.0.2.2:8000
#   - Real device on same Wi-Fi: http://<your-LAN-IP>:8000  (e.g. http://192.168.1.42:8000)
#   - Production: https://api.your-domain.tld
EXPO_PUBLIC_API_URL=http://localhost:8000

# App Store Connect non-consumable product id for lifetime unlock.
EXPO_PUBLIC_IAP_LIFETIME_PRODUCT_ID=lifetime_full_access
